# Central configuration for IFS downloads
# Edit only the values on the right-hand side. No quotes, no spaces.
# This file is read by submit_ifs_download.sh and its values are exported
# as environment variables for child processes.

# Output directory for all downloaded data
# Absolute or relative path. If unset, submit_ifs_download.sh will default to "$PWD/ifs_output".
# Examples:
#   OUTPUT_DIR=./ifs_output
#   OUTPUT_DIR=/data/projects/ifs
OUTPUT_DIR=/capstor/store/cscs/swissai/a122/ojoel/oceanography_data/ifs24_inits2024

# Time step in hours
INTERVAL=6

# Maximum lead time to request (in hours).
# Typical values: 168 (7 days), 240 (10 days). Must be a multiple of INTERVAL.
MAX_LEAD_TIME_HOURS=24

# Number of ensemble members per individual MARS request (1-50).
# Keep at 50 to minimize catalogue lookups; lower this if memory becomes a concern.
ENSEMBLE_MARS_CHUNK_SIZE=50

# What to download: ensemble | control | both
DOWNLOAD_TYPE=control

# Use a tiny debug subset (0 or 1). 1 drastically reduces area/levels/vars.
DEBUG_SMALL=0

# Model directory under each date (must match what Python writes)
MODEL_NAME=ifs

# Field selections for the requests (comma-separated lists)
# GRID: lat/lon resolution in degrees (lon,lat)
IFS_GRID=0.25,0.25
# AREA: N/W/S/E bounds
IFS_AREA=90,-180,-90,180
# Pressure-level heights in hPa (ECMWF ENFO PL set omits 600 hPa)
IFS_PRESSURE_LEVELS=
# Pressure-level parameters (short names)
IFS_PRESSURE_LEVEL_PARAMS=
# Single-level parameters (short names)
#IFS_SINGLE_LEVEL_PARAMS=10u,10v,2t,2d,msl,msdwswrf,msdwlwrf,mtpr
IFS_SINGLE_LEVEL_PARAMS=10u,10v,2t,2d,msl,ssrd,strd,260048

# Optional: path to an existing ecCodes installation (leave empty to auto-detect)
# Example: /users/$USER/miniforge3/envs/apps
ECCODES_DIR=/capstor/store/cscs/swissai/a122/ojoel/ifs_download/.venv/lib/python3.14/site-packages

# Date ranges to process (comma-separated list of start|end pairs)
# Format: YYYY-MM-DDTHH|YYYY-MM-DDTHH,YYYY-MM-DDTHH|YYYY-MM-DDTHH,...
# All mondays and tuesdays in 2024:
DATE_RANGES=2024-01-01T00|2024-01-01T00,2024-01-02T00|2024-01-02T00,2024-01-08T00|2024-01-08T00,2024-01-09T00|2024-01-09T00,2024-01-15T00|2024-01-15T00,2024-01-16T00|2024-01-16T00,2024-01-22T00|2024-01-22T00,2024-01-23T00|2024-01-23T00,2024-01-29T00|2024-01-29T00,2024-01-30T00|2024-01-30T00,2024-02-05T00|2024-02-05T00,2024-02-06T00|2024-02-06T00,2024-02-12T00|2024-02-12T00,2024-02-13T00|2024-02-13T00,2024-02-19T00|2024-02-19T00,2024-02-20T00|2024-02-20T00,2024-02-26T00|2024-02-26T00,2024-02-27T00|2024-02-27T00,2024-03-04T00|2024-03-04T00,2024-03-05T00|2024-03-05T00,2024-03-11T00|2024-03-11T00,2024-03-12T00|2024-03-12T00,2024-03-18T00|2024-03-18T00,2024-03-19T00|2024-03-19T00,2024-03-25T00|2024-03-25T00,2024-03-26T00|2024-03-26T00,2024-04-01T00|2024-04-01T00,2024-04-02T00|2024-04-02T00,2024-04-08T00|2024-04-08T00,2024-04-09T00|2024-04-09T00,2024-04-15T00|2024-04-15T00,2024-04-16T00|2024-04-16T00,2024-04-22T00|2024-04-22T00,2024-04-23T00|2024-04-23T00,2024-04-29T00|2024-04-29T00,2024-04-30T00|2024-04-30T00,2024-05-06T00|2024-05-06T00,2024-05-07T00|2024-05-07T00,2024-05-13T00|2024-05-13T00,2024-05-14T00|2024-05-14T00,2024-05-20T00|2024-05-20T00,2024-05-21T00|2024-05-21T00,2024-05-27T00|2024-05-27T00,2024-05-28T00|2024-05-28T00,2024-06-03T00|2024-06-03T00,2024-06-04T00|2024-06-04T00,2024-06-10T00|2024-06-10T00,2024-06-11T00|2024-06-11T00,2024-06-17T00|2024-06-17T00,2024-06-18T00|2024-06-18T00,2024-06-24T00|2024-06-24T00,2024-06-25T00|2024-06-25T00,2024-07-01T00|2024-07-01T00,2024-07-02T00|2024-07-02T00,2024-07-08T00|2024-07-08T00,2024-07-09T00|2024-07-09T00,2024-07-15T00|2024-07-15T00,2024-07-16T00|2024-07-16T00,2024-07-22T00|2024-07-22T00,2024-07-23T00|2024-07-23T00,2024-07-29T00|2024-07-29T00,2024-07-30T00|2024-07-30T00,2024-08-05T00|2024-08-05T00,2024-08-06T00|2024-08-06T00,2024-08-12T00|2024-08-12T00,2024-08-13T00|2024-08-13T00,2024-08-19T00|2024-08-19T00,2024-08-20T00|2024-08-20T00,2024-08-26T00|2024-08-26T00,2024-08-27T00|2024-08-27T00,2024-09-02T00|2024-09-02T00,