# Central configuration for IFS downloads
# Edit only the values on the right-hand side. No quotes, no spaces.
# This file is read by submit_ifs_download.sh and its values are exported
# as environment variables for child processes.

# Output directory for all downloaded data
# Absolute or relative path. If unset, submit_ifs_download.sh will default to "$PWD/ifs_output".
# Examples:
#   OUTPUT_DIR=./ifs_output
#   OUTPUT_DIR=/data/projects/ifs
OUTPUT_DIR=/capstor/store/cscs/swissai/a122/ojoel/oceanography_data

# Time step in hours
INTERVAL=6

# Maximum lead time to request (in hours).
# Typical values: 168 (7 days), 240 (10 days). Must be a multiple of INTERVAL.
MAX_LEAD_TIME_HOURS=240

# Number of ensemble members per individual MARS request (1-50).
# Keep at 50 to minimize catalogue lookups; lower this if memory becomes a concern.
ENSEMBLE_MARS_CHUNK_SIZE=50

# What to download: ensemble | control | both
DOWNLOAD_TYPE=control

# Use a tiny debug subset (0 or 1). 1 drastically reduces area/levels/vars.
DEBUG_SMALL=0

# Model directory under each date (must match what Python writes)
MODEL_NAME=ifs

# Field selections for the requests (comma-separated lists)
# GRID: lat/lon resolution in degrees (lon,lat)
IFS_GRID=0.25,0.25
# AREA: N/W/S/E bounds
IFS_AREA=90,-180,-90,180
# Pressure-level heights in hPa (ECMWF ENFO PL set omits 600 hPa)
IFS_PRESSURE_LEVELS=
# Pressure-level parameters (short names)
IFS_PRESSURE_LEVEL_PARAMS=
# Single-level parameters (short names)
#IFS_SINGLE_LEVEL_PARAMS=10u,10v,2t,2d,msl,msdwswrf,msdwlwrf,mtpr
IFS_SINGLE_LEVEL_PARAMS=10u,10v,2t,2d,msl,ssrd,strd,260048

# Optional: path to an existing ecCodes installation (leave empty to auto-detect)
# Example: /users/$USER/miniforge3/envs/apps
ECCODES_DIR=/capstor/store/cscs/swissai/a122/ojoel/ifs_download/.venv/lib/python3.14/site-packages

# Date ranges to process (comma-separated list of start|end pairs)
# Format: YYYY-MM-DDTHH|YYYY-MM-DDTHH,YYYY-MM-DDTHH|YYYY-MM-DDTHH,...
# All wednesdays in 2024:
DATE_RANGES=2024-01-03T00|2024-01-03T00,2024-01-10T00|2024-01-10T00,2024-01-17T00|2024-01-17T00,2024-01-24T00|2024-01-24T00,2024-01-31T00|2024-01-31T00,2024-02-07T00|2024-02-07T00,2024-02-14T00|2024-02-14T00,2024-02-21T00|2024-02-21T00,2024-02-28T00|2024-02-28T00,2024-03-06T00|2024-03-06T00,2024-03-13T00|2024-03-13T00,2024-03-20T00|2024-03-20T00,2024-03-27T00|2024-03-27T00,2024-04-03T00|2024-04-03T00,2024-04-10T00|2024-04-10T00,2024-04-17T00|2024-04-17T00,2024-04-24T00|2024-04-24T00,2024-05-01T00|2024-05-01T00,2024-05-08T00|2024-05-08T00,2024-05-15T00|2024-05-15T00,2024-05-22T00|2024-05-22T00,2024-05-29T00|2024-05-29T00,2024-06-05T00|2024-06-05T00,2024-06-12T00|2024-06-12T00,2024-06-19T00|2024-06-19T00,2024-06-26T00|2024-06-26T00,2024-07-03T00|2024-07-03T00,2024-07-10T00|2024-07-10T00,2024-07-17T00|2024-07-17T00,2024-07-24T00|2024-07-24T00,2024-07-31T00|2024-07-31T00,2024-08-07T00|2024-08-07T00,2024-08-14T00|2024-08-14T00,2024-08-21T00|2024-08-21T00,2024-08-28T00|2024-08-28T00,2024-09-04T00|2024-09-04T00,2024-09-11T00|2024-09-11T00,2024-09-18T00|2024-09-18T00,2024-09-25T00|2024-09-25T00,2024-10-02T00|2024-10-02T00,2024-10-09T00|2024-10-09T00,2024-10-16T00|2024-10-16T00,2024-10-23T00|2024-10-23T00,2024-10-30T00|2024-10-30T00,2024-11-06T00|2024-11-06T00,2024-11-13T00|2024-11-13T00,2024-11-20T00|2024-11-20T00,2024-11-27T00|2024-11-27T00,2024-12-04T00|2024-12-04T00,2024-12-11T00|2024-12-11T00,2024-12-18T00|2024-12-18T00,2024-12-25T00|2024-12-25T00
